<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:descendantFocusability="blocksDescendants">
    <!-- blocksDescendants: nothing here takes key focus, so the first arrow key after a tap
         isn't swallowed by Android's "leave touch mode" handling. Arrow keys are handled in
         MainActivity.dispatchKeyEvent; taps work as usual. -->

    <!-- Question card: only as tall as its text. -->
    <fragment android:name="com.whatawonderfulworld.goodnewsallen.QuestionFragment"
              android:id="@+id/question_fragment"
              android:layout_width="match_parent"
              android:layout_height="wrap_content" />

    <!-- Photo + controls take all remaining space. -->
    <fragment android:name="com.whatawonderfulworld.goodnewsallen.SelectionFragment"
              android:id="@+id/selection_fragment"
              android:layout_width="match_parent"
              android:layout_height="0dp"
              android:layout_weight="1"
              android:layout_marginTop="12dp" />

</LinearLayout>
